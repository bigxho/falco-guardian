[Unit]
Description=FALCO Guardian - Python detectors and dashboard
After=network.target falco-ebpf.service
Wants=falco-ebpf.service

[Service]
Type=simple
WorkingDirectory=/opt/falco-guardian/python
Environment=FALCO_CONFIG=/opt/falco-guardian/config/config.yaml
ExecStart=/opt/falco-guardian/venv/bin/python /opt/falco-guardian/python/main.py
Restart=on-failure
RestartSec=3
# Required only when blocker.enabled: true (to execute iptables)
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
